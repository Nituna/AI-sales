# AI Sales Analytics - Environment Configuration Example
# Copy this file to .env for local development or set these variables in Render Dashboard.

# Mistral / OpenAI / Gemini Compatible AI Search Configuration
AI_API_KEY=your_api_key_here
AI_API_ENDPOINT=https://api.mistral.ai/v1/chat/completions
AI_SEARCH_MODEL=mistral-small-latest

# Optional: Google Gemini API Key (if using Gemini)
# GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Port configuration (Render automatically injects PORT)
PORT=8080
