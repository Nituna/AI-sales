# ========================================================
# AI Mobile Sales and Inventory Analytics - Environment Configuration
# ========================================================

# 1. Server Configuration
# PORT: Web server listening port (Render provides this automatically; default: 8080)
PORT=8080

# 2. Database Configuration
# DB_TYPE: 'SQLITE' (zero-config, portable) or 'MYSQL' (relational DB)
# When set to SQLITE, the server directly uses embedded SQLite.
# When set to MYSQL or unset, the server tries MySQL first and automatically falls back to SQLite if unavailable.
DB_TYPE=SQLITE

# SQLite Storage Path (relative or absolute, e.g. data/mobile_sales_ai.db)
SQLITE_DB_PATH=data/mobile_sales_ai.db

# Optional MySQL Configuration (used if DB_TYPE=MYSQL or during MySQL discovery)
# DB_URL=jdbc:mysql://localhost:3306/mobile_sales_ai?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# DB_USER=root
# DB_PASSWORD=root

# 3. Real-Time AI & Search API Configuration (Optional)
# If AI_API_KEY is not provided, the application runs built-in real-time simulated AI search analytics.
AI_API_KEY=your_api_key_here
AI_SEARCH_MODEL=gpt-4o-mini
# AI_API_ENDPOINT=https://api.openai.com/v1/chat/completions
